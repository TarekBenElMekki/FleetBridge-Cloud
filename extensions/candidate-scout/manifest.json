{
    "manifest_version":  3,
    "name":  "FleetBridge | Candidate Scout",
    "short_name":  "FB Candidate Scout",
    "version":  "0.3.1",
    "description":  "Capture a visible professional profile, estimate career mobility from work history, map French regions and departments, and locate public-transport employers within a chosen radius.",
    "minimum_chrome_version":  "116",
    "permissions":  [
                        "activeTab",
                        "scripting",
                        "storage"
                    ],
    "action":  {
                   "default_title":  "FleetBridge Candidate Scout",
                   "default_popup":  "popup.html",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "32":  "icons/icon32.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}