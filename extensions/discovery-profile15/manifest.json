{
    "manifest_version":  3,
    "name":  "FleetBridge Discovery",
    "version":  "1.1.1",
    "description":  "Manual Google discovery and four-field LinkedIn review with regional location capture and experience totals.",
    "permissions":  [
                        "storage",
                        "tabs",
                        "scripting",
                        "alarms",
                        "sidePanel",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "https://www.google.com/*"
                         ],
    "optional_host_permissions":  [
                                      "https://*.linkedin.com/*"
                                  ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "FleetBridge Discovery",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "32":  "icons/icon32.png",
                                        "48":  "icons/icon48.png",
                                        "128":  "icons/icon128.png"
                                    }
               },
    "side_panel":  {
                       "default_path":  "panel.html"
                   },
    "options_page":  "dashboard.html",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}